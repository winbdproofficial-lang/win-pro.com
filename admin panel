:0}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.eyebrow{font-size:11px;letter-spacing:2px;color:#60a5fa;margin:0}.top h1{margin:6px 0;font-size:28px}.admin-name{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:18px}.metric span,.muted{color:var(--muted);font-size:12px}.metric h2{margin:10px 0}.delta{color:#86efac;font-size:11px}.section{margin-top:15px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.section-head h3{margin:0}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:720px}.table th,.table td{text-align:left;padding:11px;border-bottom:1px solid #1d2d40;font-size:12px}.table th{color:var(--muted)}.badge{padding:4px 8px;border-radius:999px;font-size:10px;background:#263449}.badge.active,.badge.approved{color:#86efac;background:#0d3524}.badge.pending{color:#fde68a;background:#3b300e}.badge.rejected,.badge.blocked{color:#fca5a5;background:#3b1515}.badge.suspended{color:#fde68a;background:#3b300e}.toolbar{display:grid;grid-template-columns:1fr 150px 100px;gap:10px;margin-bottom:15px}.danger{color:#fecaca;border-color:#6b2525}.login-required{padding:30px;color:var(--muted)}#toast{position:fixed;right:22px;bottom:22px;background:#132238;border:1px solid #31506f;padding:12px 16px;border-radius:10px;display:none;z-index:9}@media(max-width:900px){.sidebar{width:190px}.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.app{display:block}.sidebar{position:relative;width:auto;height:auto}.main{padding:16px}.grid{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr}.top{align-items:flex-start;gap:10px}}

let token=localStorage.getItem('winbd_admin_token')||'';let page='dashboard';const $=id=>document.getElementById(id);
async function api(url,opts={}){const headers={'Content-Type':'application/json',...(opts.headers||{})};if(token)headers.Authorization=`Bearer ${token}`;const r=await fetch(url,{...opts,headers});if(r.status===401){adminLogout(false)}return r;}
function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function money(v){return '৳ '+Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
function badge(s){return `<span class="badge ${esc(s)}">${esc(s)}</span>`}
function init(){if(token)showApp();$('loginForm').addEventListener('submit',login);document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>go(b.dataset.page));}
async function login(e){e.preventDefault();$('loginMsg').textContent='Signing in…';const r=await fetch('/api/admin/v1/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('adminUser').value,password:$('adminPass').value})});const d=await r.json();if(!r.ok){$('loginMsg').textContent=d.message||'Login failed';return}token=d.data.accessToken;localStorage.setItem('winbd_admin_token',token);localStorage.setItem('winbd_admin_user',JSON.stringify(d.data.user));showApp();}
function showApp(){$('loginScreen').hidden=true;$('app').hidden=false;const u=JSON.parse(localStorage.getItem('winbd_admin_user')||'{}');$('adminName').textContent=u.username?`Signed in as ${u.username}`:'';go(page);}
function adminLogout(reload=true){token='';localStorage.removeItem('winbd_admin_token');localStorage.removeItem('winbd_admin_user');$('app').hidden=true;$('loginScreen').hidden=false;if(reload)toast('Signed out');}
function go(p){page=p;document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('active',b.dataset.page===p));$('pageTitle').textContent=p[0].toUpperCase()+p.slice(1);({dashboard,users,payments,audit}[p]||dashboard)();}
async function dashboard(){const r=await api('/api/admin/v1/dashboard');if(r.status===401)return;const d=(await r.json()).data;$('content').innerHTML=`<div class="grid"><div class="card metric"><span>Total Players</span><h2>${Number(d.users).toLocaleString()}</h2><div class="delta">${Number(d.activeUsers).toLocaleString()} active</div></div><div class="card metric"><span>Available Balance</span><h2>${money(d.balances.balance)}</h2><div class="delta">Player wallets</div></div><div class="card metric"><span>Locked Balance</span><h2>${money(d.balances.locked)}</h2><div class="delta">Pending withdrawals</div></div><div class="card metric"><span>Pending Payments</span><h2>${d.pendingPayments}</h2><div class="delta">Needs review</div></div></div><div class="card section"><div class="section-head"><h3>Recent Payments</h3><button onclick="go('payments')">View all</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Player</th><th>Type</th><th>Amount</th><th>Method</th><th>Status</th><th>Created</th></tr></thead><tbody>${d.recentPayments.map(x=>`<tr><td>${esc(x.username)}</td><td>${esc(x.direction)}</td><td>${money(x.amount)}</td><td>${esc(x.method)}</td><td>${badge(x.status)}</td><td>${new Date(x.created_at).toLocaleString()}</td></tr>`).join('')}</tbody></table></div></div>`;}
async function users(){const r=await api('/api/admin/v1/users');if(r.status===401)return;const d=(await r.json()).data;$('content').innerHTML=`<div class="card"><div class="toolbar"><input id="uq" placeholder="Search username / email / phone"><select id="us"><option value="">All status</option><option>active</option><option>suspended</option><option>blocked</option></select><button class="primary" onclick="loadUsers()">Search</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Username</th><th>Email</th><th>Balance</th><th>Locked</th><th>Status</th><th>Action</th></tr></thead><tbody id="userRows">${d.map(rowUser).join('')}</tbody></table></div></div>`;}
function rowUser(u){return `<tr><td><b>${esc(u.username)}</b></td><td>${esc(u.email||'—')}</td><td>${money(u.balance)}</td><td>${money(u.locked_balance)}</td><td>${badge(u.status)}</td><td><button onclick="changeStatus('${u.id}','${u.status==='active'?'suspended':'active'}')">${u.status==='active'?'Suspend':'Activate'}</button> <button onclick="adjust('${u.id}','${esc(u.username)}')">Adjust</button></td></tr>`}
async function loadUsers(){const q=encodeURIComponent($('uq').value||''),s=encodeURIComponent($('us').value||'');const r=await api(`/api/admin/v1/users?q=${q}&status=${s}`);const d=(await r.json()).data;$('userRows').innerHTML=d.map(rowUser).join('');}
async function changeStatus(id,status){if(!confirm(`Set status to ${status}?`))return;const r=await api(`/api/admin/v1/users/${id}/status`,{method:'PATCH',body:JSON.stringify({status})});const d=await r.json();toast(r.ok?'Status updated':d.message);if(r.ok)users();}
async function adjust(id,name){const amount=prompt(`Balance adjustment for ${name}. Use negative to subtract.`);if(amount===null)return;const note=prompt('Reason:','Admin adjustment')||'Admin adjustment';const r=await api(`/api/admin/v1/users/${id}/adjust-balance`,{method:'POST',body:JSON.stringify({amount:Number(amount),note})});const d=await r.json();toast(r.ok?'Balance updated':d.message);if(r.ok)users();}
async function payments(){const r=await api('/api/admin/v1/payments');const d=(await r.json()).data;$('content').innerHTML=`<div class="card"><div class="section-head"><h3>Payment Intents</h3><button onclick="payments()">Refresh</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Player</th><th>Direction</th><th>Amount</th><th>Method</th><th>Status</th><th>Action</th></tr></thead><tbody>${d.map(p=>`<tr><td>${esc(p.username)}</td><td>${esc(p.direction)}</td><td>${money(p.amount)}</td><td>${esc(p.method)}</td><td>${badge(p.status)}</td><td>${p.status==='pending'?`<button class="primary" onclick="paymentAction('${p.id}','approved')">Approve</button> <button class="danger" onclick="paymentAction('${p.id}','rejected')">Reject</button>`:'—'}</td></tr>`).join('')}</tbody></table></div></div>`;}
async function paymentAction(id,status){if(!confirm(`${status} this payment?`))return;const r=await api(`/api/admin/v1/payments/${id}/status`,{method:'PATCH',body:JSON.stringify({status})});const d=await r.json();toast(r.ok?'Payment updated':d.message);if(r.ok)payments();}
async function audit(){const r=await api('/api/admin/v1/audit-logs');const d=(await r.json()).data;$('content').innerHTML=`<div class="card"><div class="section-head"><h3>Audit Logs</h3><button onclick="audit()">Refresh</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>IP</th><th>Metadata</th></tr></thead><tbody>${d.map(x=>`<tr><td>${new Date(x.created_at).toLocaleString()}</td><td>${esc(x.username||'system')}</td><td>${esc(x.action)}</td><td>${esc(x.ip||'')}</td><td>${esc(JSON.stringify(x.metadata||{}))}</td></tr>`).join('')}</tbody></table></div></div>`;}
function toast(t){const x=$('toast');x.textContent=t;x.style.display='block';setTimeout(()=>x.style.display='none',2200)}
init();
