TRUST_PROXY=false

# WINBD provider integration
WINBD_PROVIDER_BASE_URL=https://betjili365.vip
WINBD_PROVIDER_ACCESS_TOKEN=YOUR_AUTHORIZED_PROVIDER_ACCESS_TOKEN

