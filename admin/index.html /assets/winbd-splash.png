<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>WINBD-PRO Admin</title>
  <link rel="stylesheet" href="styles.css">

  <style>
    /* ================================
       WINBD-PRO 3:4 SPLASH SCREEN
       ================================ */
    #winbdSplash {
      position: fixed;
      inset: 0;
      z-index: 999999;
      width: 100%;
      height: 100%;
      background: #061b18;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: opacity .45s ease, visibility .45s ease;
    }

    #winbdSplash.hide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    #winbdSplash img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* Mobile */
    @media (max-width: 600px) {
      #winbdSplash img {
        object-fit: cover;
        width: 100%;
        height: 100%;
      }
    }
  </style>
</head>

<body>

<!-- ==========================================
     WINBD-PRO SPLASH
     ========================================== -->
<div id="winbdSplash">
  <img
    src="/assets/winbd-splash.png"
    alt="WINBD-OFFICIAL"
  >
</div>

<!-- ==========================================
     ADMIN LOGIN
     ========================================== -->
<div id="loginScreen" class="login-screen">
  <div class="login-card">
    <div class="logo-text">WINBD</div>

    <h1>WINBD-PRO</h1>
    <p>Admin Control Panel</p>

    <form id="loginForm">
      <input
        id="adminUser"
        placeholder="Username"
        required
      >

      <input
        id="adminPass"
        type="password"
        placeholder="Password"
        required
      >

      <button class="primary">
        Sign in
      </button>

      <div id="loginMsg"></div>
    </form>
  </div>
</div>

<!-- ==========================================
     ADMIN APPLICATION
     ========================================== -->
<div id="app" class="app" hidden>

  <aside class="sidebar">

    <div class="brand">
      <div class="logo-text small">
        WINBD
      </div>

      <div>
        <strong>WINBD-PRO</strong>
        <span>CONTROL PANEL</span>
      </div>
    </div>

    <nav>

      <button
        class="nav active"
        data-page="dashboard">
        ⌂ Dashboard
      </button>

      <button
        class="nav"
        data-page="users">
        ◉ Players
      </button>

      <button
        class="nav"
        data-page="payments">
        ৳ Payments
      </button>

      <button
        class="nav"
        data-page="audit">
        ≡ Audit Logs
      </button>

    </nav>

    <div class="side-note">
      <b>Gateway</b>
      <span>Provider-neutral</span>
      <small>
        Configure a licensed provider on the server.
      </small>
    </div>

    <button
      class="logout"
      onclick="adminLogout()">
      Sign out
    </button>

  </aside>

  <main class="main">

    <header class="top">

      <div>
        <p class="eyebrow">
          WINBD-PRO / ADMIN
        </p>

        <h1 id="pageTitle">
          Dashboard
        </h1>
      </div>

      <div
        id="adminName"
        class="admin-name">
      </div>

    </header>

    <section id="content"></section>

  </main>

</div>

<div id="toast"></div>

<script src="app.js"></script>

<script>
  /*
   * WINBD-PRO SPLASH CONTROL
   *
   * Splash দেখানোর পর মূল admin panel আসবে।
   */

  (function () {

    const splash =
      document.getElementById("winbdSplash");

    if (!splash) return;

    /*
     * Image load হওয়ার পর অল্প সময় splash রাখবে।
     * এতে logo/image flash না করে সুন্দরভাবে দেখা যাবে।
     */
    const minDisplayTime = 1800;

    const startTime = Date.now();

    function hideSplash() {

      const elapsed =
        Date.now() - startTime;

      const remaining =
        Math.max(0, minDisplayTime - elapsed);

      setTimeout(function () {

        splash.classList.add("hide");

        setTimeout(function () {
          splash.remove();
        }, 500);

      }, remaining);
    }

    const image =
      splash.querySelector("img");

    if (image && image.complete) {
      hideSplash();
    } else if (image) {
      image.addEventListener(
        "load",
        hideSplash,
        { once: true }
      );

      image.addEventListener(
        "error",
        hideSplash,
        { once: true }
      );
    } else {
      hideSplash();
    }

  })();
</script>

</body>
</html>
