NODE_ENV=development
PORT=8080
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGIN=http://localhost:8080
BRAND_NAME=WINBD-PRO
PAYMENT_PROVIDER=placeholder
DB_POOL_MAX=10
TRUST_PROXY=false
PUBLIC_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
PUBLIC_FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN
PROVIDER_CALLBACK_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/callback

# GitSlotPark PGSoft
WINBD_PGSOFT_ENDPOINT=https://pgapi.gitslotpark.com
WINBD_PGSOFT_AGENT_ID=YOUR_PGSOFT_AGENT_ID
WINBD_PGSOFT_API_TOKEN=YOUR_PGSOFT_API_TOKEN
WINBD_PGSOFT_SECRET_KEY=YOUR_PGSOFT_SECRET_KEY

# GitSlotPark Amusnet
WINBD_AMUSNET_ENDPOINT=https://apiv2.gitslotpark.com
WINBD_AMUSNET_AGENT_ID=YOUR_AMUSNET_AGENT_ID
WINBD_AMUSNET_API_TOKEN=YOUR_AMUSNET_API_TOKEN
WINBD_AMUSNET_SECRET_KEY=YOUR_AMUSNET_SECRET_KEY

# Optional existing providers
WINBD_PRAGMATIC_ENDPOINT=
WINBD_PRAGMATIC_AGENT_ID=
WINBD_PRAGMATIC_API_TOKEN=
WINBD_PRAGMATIC_SECRET_KEY=
WINBD_AMATIC_ENDPOINT=
WINBD_AMATIC_AGENT_ID=
WINBD_AMATIC_API_TOKEN=
WINBD_AMATIC_SECRET_KEY=
