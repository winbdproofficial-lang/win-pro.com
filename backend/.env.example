# WINBD-PRO Production Environment Configuration
# ==============================================
# Copy all values from Render dashboard settings
# NEVER commit this file with real credentials

# ========== CORE NODEJS CONFIGURATION ==========
NODE_ENV=production
PORT=8080
BRAND_NAME=WINBD-PRO

# ========== DATABASE - SUPABASE POSTGRESQL ==========
# CRITICAL: Set this in Render Environment
# Get from Supabase → Settings → Database → Connection String → Session Pooler
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_connection_string_here
DB_POOL_MAX=20

# ========== JWT AUTHENTICATION ==========
# CRITICAL: Generate a random 32+ character string
# Use: openssl rand -base64 32
JWT_SECRET=your_32_character_random_jwt_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# ========== CORS & SECURITY ==========
# CRITICAL: Set your production domain
# For multiple domains: https://example.com,https://www.example.com
CORS_ORIGIN=https://your-production-domain.com
TRUST_PROXY=true

# ========== PRAGMATIC PLAY PROVIDER ==========
# Optional: Leave empty to disable this provider
WINBD_PRAGMATIC_AGENT_ID=your_pragmatic_agent_id
WINBD_PRAGMATIC_API_TOKEN=your_pragmatic_api_token
WINBD_PRAGMATIC_SECRET_KEY=your_pragmatic_secret_key
WINBD_PRAGMATIC_ENDPOINT=https://ptapi.loginxgamesapi.com

# ========== PGSOFT PROVIDER ==========
# Optional: Leave empty to disable this provider
WINBD_PGSOFT_AGENT_ID=your_pgsoft_agent_id
WINBD_PGSOFT_API_TOKEN=your_pgsoft_api_token
WINBD_PGSOFT_SECRET_KEY=your_pgsoft_secret_key
WINBD_PGSOFT_ENDPOINT=https://ggapi.loginxgamesapi.com

# ========== AMATIC PROVIDER ==========
# Optional: Leave empty to disable this provider
WINBD_AMATIC_AGENT_ID=your_amatic_agent_id
WINBD_AMATIC_API_TOKEN=your_amatic_api_token
WINBD_AMATIC_SECRET_KEY=your_amatic_secret_key
WINBD_AMATIC_ENDPOINT=https://amapi.loginxgamesapi.com

# ========== AMUSNET PROVIDER ==========
# Optional: Leave empty to disable this provider
WINBD_AMUSNET_AGENT_ID=your_amusnet_agent_id
WINBD_AMUSNET_API_TOKEN=your_amusnet_api_token
WINBD_AMUSNET_SECRET_KEY=your_amusnet_secret_key
WINBD_AMUSNET_ENDPOINT=https://apiang.gitamus.net

# ========== PROVIDER CALLBACKS ==========
PROVIDER_CALLBACK_URL=https://win-proo-server.onrender.com/api/bt/v1/provider/callback

# ========== PAYMENT GATEWAY - SSLCOMMERZ ==========
# Optional: For payment processing in Bangladesh
SSLCOMMERZ_MODE=live
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password

# ========== TELEGRAM BOT - OPTIONAL ==========
# Optional: For admin notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL=your_telegram_channel_id
