services:
  postgres:
    image: postgres:16-alpine
    container_name: winbd-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: winbd
      POSTGRES_USER: winbd
      POSTGRES_PASSWORD: winbd
    ports:
      - "5432:5432"
    volumes:
      - winbd_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U winbd -d winbd"]
      interval: 5s
      timeout: 5s
      retries: 20

volumes:
  winbd_pgdata:
