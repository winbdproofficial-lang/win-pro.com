const bcrypt = require('bcryptjs');
const { pool } = require('./db');
const { signAccess } = require('./auth');

function adminRequired(req,res,next){
  if (!req.user || !['admin','superadmin'].includes(req.user.role))
    return res.status(403).json({success:false,message:'Admin access required'});
  next();
}
function adminUser(u){
  return {id:u.id,username:u.username,email:u.email,phone:u.phone,fullName:u.full_name,status:u.status,role:u.role,createdAt:u.created_at};
}
async function adminLogin(req,res,next){
  try{
    const {username,password}=req.body||{};
    if(!username||!password)return res.status(400).json({success:false,message:'Username and password are required'});
    const q=await pool.query("SELECT * FROM users WHERE lower(username)=lower($1) AND role IN ('admin','superadmin') LIMIT 1",[username]);
    const u=q.rows[0];
    if(!u||!(await bcrypt.compare(password,u.password_hash)))return res.status(401).json({success:false,message:'Invalid admin credentials'});
    if(u.status!=='active')return res.status(403).json({success:false,message:'Admin account is not active'});
    await pool.query('INSERT INTO audit_logs(user_id,action,ip,user_agent,metadata) VALUES($1,$2,$3,$4,$5)',[u.id,'admin_login',req.ip,req.get('user-agent')||'',{}]);
    res.json({success:true,data:{user:adminUser(u),accessToken:signAccess(u)}});
  }catch(e){next(e);}
}
async function dashboard(req,res,next){
  try{
    const [users,active,balances,pending,deposits,withdrawals,recent]=await Promise.all([
      pool.query("SELECT count(*)::int count FROM users WHERE role='player'"),
      pool.query("SELECT count(*)::int count FROM users WHERE role='player' AND status='active'"),
      pool.query("SELECT COALESCE(sum(balance),0)::numeric(18,2) balance,COALESCE(sum(locked_balance),0)::numeric(18,2) locked FROM wallets"),
      pool.query("SELECT count(*)::int count FROM payment_intents WHERE status='pending'"),
      pool.query("SELECT COALESCE(sum(amount),0)::numeric(18,2) total FROM payment_intents WHERE direction='deposit' AND status='approved'"),
      pool.query("SELECT COALESCE(sum(amount),0)::numeric(18,2) total FROM payment_intents WHERE direction='withdrawal' AND status='approved'"),
      pool.query("SELECT p.id,p.direction,p.amount,p.method,p.status,p.created_at,u.username FROM payment_intents p JOIN users u ON u.id=p.user_id ORDER BY p.created_at DESC LIMIT 8")
    ]);
    res.json({success:true,data:{users:users.rows[0].count,activeUsers:active.rows[0].count,balances:balances.rows[0],pendingPayments:pending.rows[0].count,approvedDeposits:deposits.rows[0].total,approvedWithdrawals:withdrawals.rows[0].total,recentPayments:recent.rows}});
  }catch(e){next(e);}
}
async function listUsers(req,res,next){
  try{
    const qstr=String(req.query.q||'').trim(),status=String(req.query.status||'').trim();
    const params=[],where=["u.role='player'"];
    if(qstr){params.push(`%${qstr}%`);where.push(`(u.username ILIKE $${params.length} OR COALESCE(u.email,'') ILIKE $${params.length} OR COALESCE(u.phone,'') ILIKE $${params.length})`);}
    if(status){params.push(status);where.push(`u.status=$${params.length}`);}
    const q=await pool.query(`SELECT u.id,u.username,u.email,u.phone,u.full_name,u.status,u.created_at,w.balance,w.locked_balance FROM users u LEFT JOIN wallets w ON w.user_id=u.id WHERE ${where.join(' AND ')} ORDER BY u.created_at DESC LIMIT 200`,params);
    res.json({success:true,data:q.rows});
  }catch(e){next(e);}
}
async function setUserStatus(req,res,next){
  try{
    const status=String(req.body?.status||'');
    if(!['active','suspended','blocked'].includes(status))return res.status(400).json({success:false,message:'Invalid status'});
    const q=await pool.query("UPDATE users SET status=$2,updated_at=now() WHERE id=$1 AND role='player' RETURNING id,username,status",[req.params.id,status]);
    if(!q.rows[0])return res.status(404).json({success:false,message:'Player not found'});
    await pool.query('INSERT INTO audit_logs(user_id,action,ip,user_agent,metadata) VALUES($1,$2,$3,$4,$5)',[req.params.id,'admin_status_change',req.ip,req.get('user-agent')||'',{status,adminId:req.user.sub}]);
    res.json({success:true,data:q.rows[0]});
  }catch(e){next(e);}
}
async function listPayments(req,res,next){
  try{
    const status=String(req.query.status||'').trim(),direction=String(req.query.direction||'').trim(),params=[],where=[];
    if(status){params.push(status);where.push(`p.status=$${params.length}`);}
    if(direction){params.push(direction);where.push(`p.direction=$${params.length}`);}
    const q=await pool.query(`SELECT p.*,u.username,u.email FROM payment_intents p JOIN users u ON u.id=p.user_id ${where.length?'WHERE '+where.join(' AND '):''} ORDER BY p.created_at DESC LIMIT 300`,params);
    res.json({success:true,data:q.rows});
  }catch(e){next(e);}
}
async function updatePayment(req,res,next){
  const status=String(req.body?.status||'');
  if(!['approved','rejected','cancelled'].includes(status))return res.status(400).json({success:false,message:'Invalid payment status'});
  const client=await pool.connect();
  try{
    await client.query('BEGIN');
    const p=await client.query('SELECT * FROM payment_intents WHERE id=$1 FOR UPDATE',[req.params.id]);
    const payment=p.rows[0];
    if(!payment){await client.query('ROLLBACK');return res.status(404).json({success:false,message:'Payment not found'});}
    if(payment.status!=='pending'){await client.query('ROLLBACK');return res.status(409).json({success:false,message:'Payment has already been processed'});}
    const w=await client.query('SELECT * FROM wallets WHERE user_id=$1 FOR UPDATE',[payment.user_id]);
    if(!w.rows[0])throw new Error('Wallet not found');
    if(status==='approved'){
      if(payment.direction==='deposit'){
        const nw=Number(w.rows[0].balance)+Number(payment.amount);
        await client.query('UPDATE wallets SET balance=$2,updated_at=now() WHERE user_id=$1',[payment.user_id,nw]);
        await client.query('INSERT INTO wallet_ledger(user_id,type,amount,balance_after,reference,note) VALUES($1,$2,$3,$4,$5,$6)',[payment.user_id,'deposit',payment.amount,nw,payment.id,'Admin approved deposit']);
      }else{
        const locked=Number(w.rows[0].locked_balance);
        if(locked<Number(payment.amount))throw new Error('Locked balance is insufficient');
        const newLocked=locked-Number(payment.amount);
        await client.query('UPDATE wallets SET locked_balance=$2,updated_at=now() WHERE user_id=$1',[payment.user_id,newLocked]);
        await client.query('INSERT INTO wallet_ledger(user_id,type,amount,balance_after,reference,note) VALUES($1,$2,$3,$4,$5,$6)',[payment.user_id,'withdrawal',-Number(payment.amount),Number(w.rows[0].balance),payment.id,'Admin approved withdrawal']);
      }
    }else if(payment.direction==='withdrawal'){
      await client.query('UPDATE wallets SET balance=balance+$2,locked_balance=GREATEST(locked_balance-$2,0),updated_at=now() WHERE user_id=$1',[payment.user_id,payment.amount]);
    }
    const updated=await client.query('UPDATE payment_intents SET status=$2,updated_at=now() WHERE id=$1 RETURNING *',[payment.id,status]);
    await client.query('INSERT INTO audit_logs(user_id,action,ip,user_agent,metadata) VALUES($1,$2,$3,$4,$5)',[req.user.sub,'admin_payment_update',req.ip,req.get('user-agent')||'',{paymentId:payment.id,status}]);
    await client.query('COMMIT');
    res.json({success:true,data:updated.rows[0]});
  }catch(e){await client.query('ROLLBACK');next(e);}finally{client.release();}
}
async function adjustBalance(req,res,next){
  const amount=Number(req.body?.amount),note=String(req.body?.note||'Admin adjustment').slice(0,500);
  if(!Number.isFinite(amount)||amount===0||Math.abs(amount)>100000000)return res.status(400).json({success:false,message:'Invalid adjustment amount'});
  const client=await pool.connect();
  try{
    await client.query('BEGIN');
    const w=await client.query('SELECT * FROM wallets WHERE user_id=$1 FOR UPDATE',[req.params.id]);
    if(!w.rows[0])throw Object.assign(new Error('Wallet not found'),{statusCode:404});
    const newBal=Number(w.rows[0].balance)+amount;
    if(newBal<0)throw Object.assign(new Error('Balance cannot become negative'),{statusCode:400});
    await client.query('UPDATE wallets SET balance=$2,updated_at=now() WHERE user_id=$1',[req.params.id,newBal]);
    await client.query('INSERT INTO wallet_ledger(user_id,type,amount,balance_after,reference,note) VALUES($1,$2,$3,$4,$5,$6)',[req.params.id,'admin_adjustment',amount,newBal,req.user.sub,note]);
    await client.query('INSERT INTO audit_logs(user_id,action,ip,user_agent,metadata) VALUES($1,$2,$3,$4,$5)',[req.params.id,'admin_balance_adjustment',req.ip,req.get('user-agent')||'',{amount,note,adminId:req.user.sub}]);
    await client.query('COMMIT');res.json({success:true,data:{balance:newBal}});
