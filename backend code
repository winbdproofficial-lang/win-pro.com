const amountSchema=z.object({amount:z.coerce.number().positive().max(100000000),method:z.string().min(2).max(32)});

function publicUser(u){return{id:u.id,username:u.username,email:u.email,phone:u.phone,fullName:u.full_name,currency:u.currency,status:u.status,role:u.role,createdAt:u.created_at};}
