app.post('/api/bt/v2_1/user/register',async(req,res,next)=>{
  try{
    const input=registerSchema.parse(req.body),hash=await bcrypt.hash(input.password,12),client=await pool.connect();
    try{
      await client.query('BEGIN');
      const q=await client.query('INSERT INTO users(username,email,phone,password_hash,full_name,currency) VALUES($1,$2,$3,$4,$5,$6) RETURNING *',[input.username,input.email||null,input.phone||null,hash,input.fullName||null,input.currency]);
      const u=q.rows[0];await client.query('INSERT INTO wallets(user_id) VALUES($1)',[u.id]);await client.query('COMMIT');
      const accessToken=signAccess(u),refreshToken=await issueRefresh(u.id);await audit(req,u.id,'register');
      res.status(201).json({success:true,data:{user:publicUser(u),accessToken,refreshToken}});
    }catch(e){await client.query('ROLLBACK');if(e.code==='23505')return res.status(409).json({success:false,message:'Username, email or phone already exists'});throw e;}finally{client.release();}
  }catch(e){next(e);}
});

app.post('/api/bt/v2_1/user/login',loginLimiter,async(req,res,next)=>{
  try{
    const input=loginSchema.parse(req.body),q=await pool.query('SELECT * FROM users WHERE lower(username)=lower($1) LIMIT 1',[input.username]),u=q.rows[0];
    if(!u||!(await bcrypt.compare(input.password,u.password_hash)))return res.status(401).json({success:false,message:'Invalid username or password'});
    if(u.status!=='active')return res.status(403).json({success:false,message:'Account is not active'});
    const accessToken=signAccess(u),refreshToken=await issueRefresh(u.id);await audit(req,u.id,'login');
    res.json({success:true,data:{user:publicUser(u),accessToken,refreshToken}});
  }catch(e){next(e);}
});

app.post('/api/bt/v1/user/refreshToken',async(req,res,next)=>{
  try{
    const raw=req.body?.refreshToken;if(!raw)return res.status(400).json({success:false,message:'refreshToken is required'});
    const q=await pool.query('SELECT u.* FROM refresh_tokens r JOIN users u ON u.id=r.user_id WHERE r.token_hash=$1 AND r.revoked_at IS NULL AND r.expires_at>now()',[hashToken(raw)]);
    if(!q.rows[0])return res.status(401).json({success:false,message:'Invalid refresh token'});
    await revokeRefresh(raw);const u=q.rows[0];
    res.json({success:true,data:{accessToken:signAccess(u),refreshToken:await issueRefresh(u.id)}});
  }catch(e){next(e);}
});

