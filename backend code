app.post('/api/bt/v1/payment/withdraw',authRequired,async(req,res,next)=>{
  try{
    const input=amountSchema.parse(req.body),client=await pool.connect();
    try{
      await client.query('BEGIN');
      const w=await client.query('SELECT balance,locked_balance FROM wallets WHERE user_id=$1 FOR UPDATE',[req.user.sub]);
      if(!w.rows[0]||Number(w.rows[0].balance)<input.amount){await client.query('ROLLBACK');return res.status(400).json({success:false,message:'Insufficient available balance'});}
      await client.query('UPDATE wallets SET balance=balance-$2,locked_balance=locked_balance+$2,updated_at=now() WHERE user_id=$1',[req.user.sub,input.amount]);
      const p=await client.query("INSERT INTO payment_intents(user_id,direction,amount,method) VALUES($1,'withdrawal',$2,$3) RETURNING *",[req.user.sub,input.amount,input.method]);
      await client.query('COMMIT');res.status(201).json({success:true,data:{paymentIntent:p.rows[0],status:'pending'}});
    }catch(e){await client.query('ROLLBACK');throw e;}finally{client.release();}
  }catch(e){next(e);}
});
