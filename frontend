:root{font-family:Inter,system-ui,Arial,sans-serif;color:#e5e7eb;background:#07111f}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 20% 0,#123055 0,#07111f 38%,#050a12 100%)}header{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 5%;border-bottom:1px solid #1e2d40;background:#07111fcc;backdrop-filter:blur(12px);position:sticky;top:0;z-index:2}.brand{font-size:20px;font-weight:800;color:#60a5fa}nav{display:flex;gap:8px}button{border:1px solid #30445b;background:#0d1a2b;color:#e5e7eb;border-radius:9px;padding:10px 15px;cursor:pointer}button:hover{filter:brightness(1.15)}.primary{background:#2563eb;border-color:#2563eb}.page{max-width:1100px;margin:auto;padding:60px 22px}.hero{display:grid;grid-template-columns:1.5fr 1fr;gap:28px;align-items:center;min-height:420px}.eyebrow{color:#60a5fa;font-weight:700;letter-spacing:2px}.hero h1{font-size:64px;margin:12px 0}.hero p{color:#a9b6c8;font-size:18px;line-height:1.7;max-width:620px}.actions{display:flex;gap:12px;margin-top:25px}.hero-card,.card,.modal-card{background:#0c1828;border:1px solid #20344c;border-radius:18px;padding:24px;box-shadow:0 18px 50px #0005}.hero-card{display:flex;flex-direction:column;gap:12px}.hero-card strong{font-size:26px;color:#4ade80}.hero-card small,.card span{color:#94a3b8}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.cards .card{display:flex;justify-content:space-between}.forms{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:22px}form{border:1px solid #20344c;border-radius:14px;padding:18px;display:grid;gap:10px}input,select{width:100%;padding:12px;border-radius:9px;border:1px solid #30445b;background:#07111f;color:#fff}.modal{position:fixed;inset:0;background:#0009;display:grid;place-items:center;padding:20px;z-index:5}.modal-card{width:min(440px,100%);position:relative}.close{position:absolute;right:15px;top:15px;border:0;background:transparent;font-size:25px}.modal form{border:0;padding:0;margin-top:20px}.modal h2{margin-top:0}.msg{color:#fca5a5}.success{color:#86efac}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:10px;border-bottom:1px solid #1f3044}.scroll{overflow:auto}@media(max-width:760px){.hero{grid-template-columns:1fr}.hero h1{font-size:44px}.cards,.forms{grid-template-columns:1fr}nav button{padding:8px}.page{padding-top:30px}}

<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WINBD-PRO</title><link rel="stylesheet" href="style.css">
</head>
<body>
<header><div class="brand">WINBD-PRO</div><nav><button onclick="show('home')">Home</button><button onclick="show('wallet')">Wallet</button><button onclick="show('profile')">Profile</button><button id="logout" onclick="logout()" hidden>Logout</button></nav></header>
<main>
<section id="home" class="page">
<div class="hero"><div><span class="eyebrow">WINBD-PRO</span><h1>স্বাগতম</h1><p>আপনার অ্যাকাউন্ট, ওয়ালেট এবং পেমেন্ট ইন্টেন্ট নিরাপদভাবে ম্যানেজ করুন।</p><div class="actions"><button class="primary" onclick="openModal('login')">Login</button><button onclick="openModal('register')">Create account</button></div></div><div class="hero-card"><b>API status</b><strong id="health">Checking…</strong><small>Backend health endpoint</small></div></div>
<div class="cards"><div class="card"><span>Security</span><b>JWT + bcrypt</b></div><div class="card"><span>Database</span><b>PostgreSQL</b></div><div class="card"><span>Admin</span><b>Role protected</b></div></div>
</section>
<section id="wallet" class="page" hidden><div class="card"><h2>Wallet</h2><div id="walletData">Login required.</div><div class="forms"><form onsubmit="payment(event,'deposit')"><h3>Deposit intent</h3><input id="depAmount" type="number" min="1" step="0.01" placeholder="Amount" required><select id="depMethod"><option>bKash</option><option>Nagad</option><option>Rocket</option></select><button class="primary">Create intent</button></form><form onsubmit="payment(event,'withdraw')"><h3>Withdrawal request</h3><input id="wdAmount" type="number" min="1" step="0.01" placeholder="Amount" required><select id="wdMethod"><option>bKash</option><option>Nagad</option><option>Rocket</option></select><button class="primary">Request withdrawal</button></form></div></div></section>
<section id="profile" class="page" hidden><div class="card"><h2>Profile</h2><div id="profileData">Login required.</div></div></section>
</main>
<div id="modal" class="modal" hidden><div class="modal-card"><button class="close" onclick="closeModal()">×</button><div id="modalBody"></div></div></div>
<div id="toast"></div><script src="app.js"></script>
</body></html>

const $=id=>document.getElementById(id);let accessToken=localStorage.getItem('winbd_access')||'';let refreshToken=localStorage.getItem('winbd_refresh')||'';
async function api(url,opts={}){const headers={'Content-Type':'application/json',...(opts.headers||{})};if(accessToken)headers.Authorization=`Bearer ${accessToken}`;let r=await fetch(url,{...opts,headers});if(r.status===401&&refreshToken){const rr=await fetch('/api/bt/v1/user/refreshToken',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({refreshToken})});const rd=await rr.json();if(rr.ok){accessToken=rd.data.accessToken;refreshToken=rd.data.refreshToken;localStorage.setItem('winbd_access',accessToken);localStorage.setItem('winbd_refresh',refreshToken);headers.Authorization=`Bearer ${accessToken}`;r=await fetch(url,{...opts,headers});}}return r;}
async function health(){try{const r=await fetch('/api/bt/health');const d=await r.json();$('health').textContent=d.status==='000000'?'Connected':'Unavailable';}catch{$('health').textContent='Unavailable';}}
function show(id){document.querySelectorAll('.page').forEach(x=>x.hidden=x.id!==id);if(id==='wallet')loadWallet();if(id==='profile')loadProfile();}
function openModal(type){const register=type==='register';$('modalBody').innerHTML=`<h2>${register?'Create account':'Login'}</h2><form onsubmit="${register?'register(event)':'login(event)'}">${register?'<input id="fullName" placeholder="Full name"><input id="email" type="email" placeholder="Email">':''}<input id="username" placeholder="Username" required><input id="password" type="password" placeholder="Password" minlength="8" required>${register?'<input id="phone" placeholder="Phone"><input id="confirm" type="password" placeholder="Confirm password" minlength="8" required>':''}<button class="primary">${register?'Register':'Login'}</button><div id="formMsg"></div></form>`;$('modal').hidden=false;}
function closeModal(){$('modal').hidden=true;}
async function login(e){e.preventDefault();const body={username:$('username').value,password:$('password').value};const r=await fetch('/api/bt/v2_1/user/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok){$('formMsg').className='msg';$('formMsg').textContent=d.message||'Login failed';return;}setTokens(d.data);closeModal();toast('Login successful');updateNav();}
async function register(e){e.preventDefault();if($('password').value!==$('confirm').value){$('formMsg').className='msg';$('formMsg').textContent='Passwords do not match';return;}const body={username:$('username').value,password:$('password').value,fullName:$('fullName').value||undefined,email:$('email').value||undefined,phone:$('phone').value||undefined};const r=await fetch('/api/bt/v2_1/user/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok){$('formMsg').className='msg';$('formMsg').textContent=d.message||'Registration failed';return;}setTokens(d.data);closeModal();toast('Account created');updateNav();}
function setTokens(d){accessToken=d.accessToken;refreshToken=d.refreshToken;localStorage.setItem('winbd_access',accessToken);localStorage.setItem('winbd_refresh',refreshToken);}
async function logout(){try{await api('/api/bt/v1/user/logout',{method:'POST',body:JSON.stringify({refreshToken})});}catch{}accessToken='';refreshToken='';localStorage.removeItem('winbd_access');localStorage.removeItem('winbd_refresh');updateNav();show('home');toast('Logged out');}
function updateNav(){$('logout').hidden=!accessToken;}
async function loadWallet(){if(!accessToken){$('walletData').innerHTML='<p>Login first to view wallet.</p>';return}const r=await api('/api/bt/v1/user/getBalance');const d=await r.json();if(!r.ok){$('walletData').textContent=d.message;return}$('walletData').innerHTML=`<div class="cards"><div class="card"><span>Available</span><b>৳ ${Number(d.data.balance).toLocaleString()}</b></div><div class="card"><span>Locked</span><b>৳ ${Number(d.data.locked_balance).toLocaleString()}</b></div></div>`;}
async function loadProfile(){if(!accessToken){$('profileData').textContent='Login first to view profile.';return}const r=await api('/api/bt/v1/user/getProfile');const d=await r.json();if(!r.ok){$('profileData').textContent=d.message;return}const u=d.data;$('profileData').innerHTML=`<p><b>Username:</b> ${u.username}</p><p><b>Name:</b> ${u.fullName||'—'}</p><p><b>Email:</b> ${u.email||'—'}</p><p><b>Phone:</b> ${u.phone||'—'}</p><p><b>Status:</b> ${u.status}</p>`;}
async function payment(e,direction){e.preventDefault();if(!accessToken){toast('Login required');return}const amount=Number($(direction==='deposit'?'depAmount':'wdAmount').value),method=$(direction==='deposit'?'depMethod':'wdMethod').value;const r=await api(`/api/bt/v1/payment/${direction}`,{method:'POST',body:JSON.stringify({amount,method})});const d=await r.json();toast(r.ok?'Payment intent created':(d.message||'Request failed'));if(r.ok)loadWallet();}
function toast(t){const x=$('toast');x.textContent=t;x.style.cssText='position:fixed;bottom:22px;right:22px;padding:12px 16px;background:#132238;border:1px solid #31506f;border-radius:10px;z-index:9';setTimeout(()=>x.textContent='',2200)}
health();updateNav();

